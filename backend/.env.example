# Copy to .env for local Flask CLI use. Never commit actual credentials.
# Existing OS environment variables take precedence over .env.
FLASK_RUN_PORT=5000

# Local development: SSH tunnel 127.0.0.1:3307 -> remote localhost:3306
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=
DB_USER=
DB_PASSWORD=

# Production: supply all five DB_* values through cPanel Environment variables.
# DB_HOST=localhost
# DB_PORT=3306
# Values containing dotenv special characters must be correctly quoted.
